# Copy to .env and fill in. .env is gitignored — never commit it.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=
# GitHub (sinfoo) > Settings > Developer settings > Tokens (classic) > scope: gist
GITHUB_TOKEN=

# License registry gist (secret) on sinfoo
LICENSE_GIST_ID=f5600a536084654729de796543679071
UNIVERSAL_GIST_ID=

# License HTTP API port (put an HTTPS tunnel/proxy in front of it)
LICENSE_API_PORT=8765

# Public gist the bot writes its tunnel URL to (app reads it)
ENDPOINT_GIST_ID=2cbf912a75c7a5aa3c601abcc0d704b9
