{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "plugin": [
    "opencode-skill-creator",
    "oh-my-openagent@latest",
    "opencode-agent-skills",
    "@tarquinen/opencode-dcp",
    "opencode-history-search",
    "opencode-markitdown",
    "C:\\Users\\sinfo\\.local\\share\\ponytail\\.opencode\\plugins\\ponytail.mjs"
  ],
  "skills": {
    "paths": [
      "C:\\Users\\sinfo\\.agents\\skills",
      "C:\\Users\\sinfo\\.config\\opencode\\skills"
    ]
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "timeout": 60000
    },
    "desktop-commander": {
      "type": "local",
      "command": ["npx", "-y", "@wonderwhy-er/desktop-commander@latest"],
      "enabled": true,
      "timeout": 60000
    },
    "steam-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@praeses/steam-mcp"],
      "enabled": true,
      "timeout": 60000,
      "env": {
        "STEAM_API_KEY": "37D260F28D24926E50561940975D7D36"
      }
    },
    "with-context-mcp": {
      "type": "local",
      "command": ["npx", "-y", "with-context-mcp"],
      "enabled": true,
      "timeout": 60000
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "timeout": 10000
    },
    "websearch": {
      "type": "local",
      "command": ["npx", "-y", "one-search-mcp"],
      "enabled": false,
      "timeout": 30000
    },
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp"],
      "enabled": false,
      "timeout": 15000,
      "environment": {
        "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY_HERE"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\sinfo\\Downloads\\filesOPENCODE"],
      "enabled": true,
      "timeout": 10000
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "github-mcp-server"],
      "enabled": false,
      "timeout": 60000,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 10000
    },
    "imagesorcery-mcp": {
      "type": "local",
      "command": ["C:\\Users\\sinfo\\.local\\bin\\imagesorcery-mcp.exe"],
      "enabled": true,
      "timeout": 120000
    },
    "ponytail": {
      "type": "local",
      "command": ["node", "C:\\Users\\sinfo\\.local\\share\\ponytail\\ponytail-mcp\\index.js"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 3,
    "preserve_recent_tokens": 16000,
    "reserved": 16000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "dist-electron/**",
      ".git/**",
      "dev-release/**",
      "graphify-out/**",
      ".omo/**",
      ".claude/**",
      ".opencode/**",
      "backups/**",
      "data/**",
      "games/**",
      "*.db"
    ]
  }
}
