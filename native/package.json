{
  "name": "ahg-native-image",
  "version": "1.0.0",
  "description": "Native C++ image processing module for AHG Unlocker — WebP/JPEG decode, WebP encode, LQIP generation, GPU offload",
  "main": "build/Release/ahg-native-image.node",
  "types": "index.d.ts",
  "os": ["win32"],
  "cpu": ["x64"],
  "scripts": {
    "build": "node-gyp rebuild",
    "build:cmake": "cmake --build build --config Release",
    "configure": "cmake -S . -B build -G \"Visual Studio 17 2022\" -A x64 -DCMAKE_BUILD_TYPE=Release",
    "clean": "node-gyp clean && if exist build rmdir /s /q build",
    "test": "node tests/test.js"
  },
  "binary": {
    "napi_versions": [9]
  },
  "dependencies": {
    "node-addon-api": "^8.3.0"
  },
  "devDependencies": {
    "node-gyp": "^11.1.0"
  }
}
